{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "muse-meta-assistant",
  "version": "1.0.0",
  "description": "Plan, sequence, review, and synthesize complex dealership work across Dots and available Dealer AI plugins.",
  "author": {
    "name": "Dealer Growth Hackers",
    "url": "https://dealergrowthhackers.com/"
  },
  "homepage": "https://dealeraiplugins.com/plugins/muse-meta-assistant/",
  "repository": "https://github.com/arielcoro/dealer-ai-plugins",
  "license": "MIT",
  "keywords": [
    "ChatGPT for car dealers",
    "Codex for car dealers",
    "car dealership",
    "automotive retail",
    "dealer AI",
    "muse meta assistant",
    "muse-meta-assistant"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Dealer Muse Workflow",
        "shortDescription": "Orchestrate dealer AI work",
        "longDescription": "An independent Dealer Growth Hackers workflow for planning, sequencing, reviewing, and synthesizing complex dealership work across Muse, Dots, and available Dealer AI plugins. It does not claim affiliation with another Muse product or publisher.",
        "developerName": "Dealer Growth Hackers",
        "category": "Business & Operations",
        "capabilities": [
          "Orchestrate dealer AI work"
        ],
        "websiteURL": "https://dealeraiplugins.com/plugins/muse-meta-assistant/",
        "supportURL": "https://dealeraiplugins.com/support/",
        "privacyPolicyURL": "https://dealeraiplugins.com/privacy/",
        "termsOfServiceURL": "https://dealeraiplugins.com/terms/",
        "defaultPrompt": [
          "Use Muse to plan and coordinate this multi-plugin project."
        ],
        "brandColor": "#0F62FE",
        "brandColorDark": "#78A9FF",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg"
      },
      "publication": {
        "release_notes": "Initial Dealer Growth Hackers release for ChatGPT and Codex."
      }
    }
  }
}
