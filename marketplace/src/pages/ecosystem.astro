---
import Layout from "../layouts/Layout.astro";

const groups = [
  {
    id: "authority",
    number: "01",
    label: "Authority + guidance",
    purpose: "Where dealers learn, choose a direction, and engage expert help.",
    sites: [
      { name: "Dealer Growth Hackers", url: "https://dealergrowthhackers.com/", role: "Publisher and automotive growth agency" },
      { name: "Dealer AI Guy", url: "https://www.dealeraiguy.com/", role: "Independent education, news, and buyer guidance" },
      { name: "Dealer AI Guys", url: "https://dealeraiguys.com/", role: "AI implementation and dealership advisory" },
      { name: "Dealer AI Partners", url: "https://dealeraipartners.com/", role: "Operational AI programs and partner delivery" },
      { name: "Dealer Fractional CMOs", url: "https://dealerfractionalcmos.com/", role: "Fractional marketing leadership" },
      { name: "Dealer AI Works", url: "https://dealeraiworks.com/", role: "Practical AI implementation programs" },
    ],
  },
  {
    id: "knowledge",
    number: "02",
    label: "Open knowledge",
    purpose: "Reusable instructions dealers can inspect, adapt, and run in AI assistants.",
    sites: [
      { name: "Dealer AI Plugins", url: "https://dealeraiplugins.com/", role: "OpenAI plugins for ChatGPT and Codex" },
      { name: "Dealer AI Skills", url: "https://dealeraiskills.com/", role: "Open-source Claude skills for dealerships" },
      { name: "Dealer AI Workflows", url: "https://dealeraiworkflows.com/", role: "Repeatable dealership workflow library" },
      { name: "Dealer AI Prompts", url: "https://dealeraiprompts.com/", role: "Free dealership prompt collection" },
      { name: "Dealer AI Tools", url: "https://dealeraitools.com/", role: "Free dealership AI utilities" },
    ],
  },
  {
    id: "diagnostics",
    number: "03",
    label: "Diagnostics + visibility",
    purpose: "Measure the problem, identify its cause, and create a prioritized work order.",
    sites: [
      { name: "Dealer Website Grader", url: "https://dealerwebsitegrader.com/", role: "Fast website and technical baseline" },
      { name: "Dealer AI Visibility", url: "https://dealeraivisibility.com/", role: "Automated AI-discovery baseline" },
      { name: "Dealer AEO Audit", url: "https://dealeraeoaudit.com/", role: "Human-reviewed AI visibility diagnosis" },
      { name: "Dealer Site Doctors", url: "https://dealersitedoctors.com/", role: "Website diagnosis, repair, and verification" },
      { name: "Dealer Sitemap", url: "https://dealersitemap.com/", role: "Inventory discovery and sitemap health" },
      { name: "Dealer Diet", url: "https://dealerdiet.com/", role: "Dealer page-weight and crawlability check" },
    ],
  },
  {
    id: "infrastructure",
    number: "04",
    label: "Agent infrastructure",
    purpose: "Give AI agents governed access to current dealership inventory, offers, and operating facts.",
    sites: [
      { name: "Dealer Agent Protocol", url: "https://dealeragentprotocol.com/", role: "Open semantics for automotive retail agents" },
      { name: "DealershipMCP", url: "https://dealershipmcp.com/", role: "Dealer website and retail-data MCP layer" },
      { name: "Dealer Agent Gateway", url: "https://dealeragentgateway.com/", role: "Governed gateway and query observability" },
    ],
  },
  {
    id: "products",
    number: "05",
    label: "Dealer products",
    purpose: "Purpose-built products that improve conversion, publishing, messaging, and commerce.",
    sites: [
      { name: "Dealer AI Sites", url: "https://dealeraisites.com/", role: "AI-ready dealer websites and digital retail foundations" },
      { name: "DealerWidgets", url: "https://dealerwidgets.com/", role: "Managed dealership conversion layer" },
      { name: "VinPoster", url: "https://vinposter.com/", role: "Automated inventory social publishing" },
      { name: "Ándale Auto", url: "https://andaleauto.com/", role: "Headless dealer commerce pages" },
    ],
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Dealer Growth Hackers product and resource ecosystem",
  numberOfItems: groups.reduce((total, group) => total + group.sites.length, 0),
  itemListElement: groups.flatMap((group) => group.sites).map((site, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: site.name,
    url: site.url,
  })),
};
---

<Layout
  title="Dealer AI Ecosystem | Tools, Diagnostics & Implementation"
  description="Explore the connected Dealer Growth Hackers ecosystem for dealership AI education, open-source workflows, diagnostics, agent infrastructure, and dealer technology."
  structuredData={structuredData}
>
  <section class="ecosystem-hero">
    <p class="kicker">One portfolio · Clear jobs</p>
    <h1>The dealer AI ecosystem,<br /><em>organized by outcome.</em></h1>
    <p>These sites are connected, but they do different jobs. Start with the outcome you need: learn, measure, implement, connect live data, or deploy a dealer-facing product.</p>
  </section>

  <nav class="ecosystem-jump" aria-label="Ecosystem categories">
    {groups.map((group) => <a href={`#${group.id}`}><span>{group.number}</span>{group.label}</a>)}
  </nav>

  <section class="ecosystem-map" aria-labelledby="ecosystem-map-title">
    <div class="ecosystem-map-copy">
      <p class="kicker">How the system moves</p>
      <h2 id="ecosystem-map-title">Learn → Diagnose → Implement → Connect → Grow</h2>
      <p>Dealer Growth Hackers is the publisher and operating center. Dealer AI Guy explains the market. The diagnostic sites identify the problem. The implementation brands and open libraries turn the findings into action. The protocol, MCP, and gateway products connect governed live data.</p>
    </div>
    <ol class="ecosystem-flow" aria-label="Dealer AI adoption path">
      <li><span>01</span><b>Learn</b><small>Dealer AI Guy</small></li>
      <li><span>02</span><b>Measure</b><small>Graders + audits</small></li>
      <li><span>03</span><b>Build</b><small>Skills + plugins</small></li>
      <li><span>04</span><b>Connect</b><small>Protocol + MCP</small></li>
      <li><span>05</span><b>Operate</b><small>Partners + products</small></li>
    </ol>
  </section>

  <section class="ecosystem-directory" aria-label="Dealer AI ecosystem directory">
    {groups.map((group) => (
      <article class="ecosystem-group" id={group.id}>
        <header>
          <span>{group.number}</span>
          <div><p class="kicker">{group.label}</p><h2>{group.purpose}</h2></div>
        </header>
        <div class="ecosystem-sites">
          {group.sites.map((site) => (
            <a href={site.url} target="_blank" rel="noreferrer">
              <strong>{site.name}</strong>
              <p>{site.role}</p>
              <span>{new URL(site.url).hostname.replace("www.", "")} ↗</span>
            </a>
          ))}
        </div>
      </article>
    ))}
  </section>

  <section class="ecosystem-related">
    <div><p class="kicker">Related ventures</p><h2>Technology education and portfolio stewardship.</h2></div>
    <div>
      <a href="https://tutecnologia.com/" target="_blank" rel="noreferrer"><strong>Tu Tecnología</strong><span>Spanish-language technology education ↗</span></a>
      <a href="https://corocapitalpartners.com/" target="_blank" rel="noreferrer"><strong>Coro Capital Partners</strong><span>Private investment and portfolio stewardship ↗</span></a>
    </div>
  </section>
</Layout>
