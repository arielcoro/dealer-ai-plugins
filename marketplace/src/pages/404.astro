---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found" noindex={true}>
  <section class="not-found">
    <span>404</span>
    <h1>That plugin took a wrong turn.</h1>
    <p>The package or page you requested does not exist.</p>
    <a class="primary-button" href="/#catalog">Return to the catalog</a>
  </section>
</Layout>
